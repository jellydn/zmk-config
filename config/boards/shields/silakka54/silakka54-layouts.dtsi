#include <physical_layouts.dtsi>

/ {
    silakka54_layout: silakka54_layout {
        compatible = "zmk,physical-layout";
        display-name = "Silakka54";

        // Approximated from the Vial layout: 4x6 grid with column stagger
        // plus three thumb keys per half.
        keys  //                     w   h    x    y  rot rx ry
            = <&key_physical_attrs 100 100    0   25 0 0 0>
            , <&key_physical_attrs 100 100  100   25 0 0 0>
            , <&key_physical_attrs 100 100  200    0 0 0 0>
            , <&key_physical_attrs 100 100  300    0 0 0 0>
            , <&key_physical_attrs 100 100  400   25 0 0 0>
            , <&key_physical_attrs 100 100  500   50 0 0 0>
            , <&key_physical_attrs 100 100  725   50 0 0 0>
            , <&key_physical_attrs 100 100  825   25 0 0 0>
            , <&key_physical_attrs 100 100  925    0 0 0 0>
            , <&key_physical_attrs 100 100 1025    0 0 0 0>
            , <&key_physical_attrs 100 100 1125   25 0 0 0>
            , <&key_physical_attrs 100 100 1225   25 0 0 0>
            , <&key_physical_attrs 100 100    0  125 0 0 0>
            , <&key_physical_attrs 100 100  100  125 0 0 0>
            , <&key_physical_attrs 100 100  200  100 0 0 0>
            , <&key_physical_attrs 100 100  300  100 0 0 0>
            , <&key_physical_attrs 100 100  400  125 0 0 0>
            , <&key_physical_attrs 100 100  500  150 0 0 0>
            , <&key_physical_attrs 100 100  725  150 0 0 0>
            , <&key_physical_attrs 100 100  825  125 0 0 0>
            , <&key_physical_attrs 100 100  925  100 0 0 0>
            , <&key_physical_attrs 100 100 1025  100 0 0 0>
            , <&key_physical_attrs 100 100 1125  125 0 0 0>
            , <&key_physical_attrs 100 100 1225  125 0 0 0>
            , <&key_physical_attrs 100 100    0  225 0 0 0>
            , <&key_physical_attrs 100 100  100  225 0 0 0>
            , <&key_physical_attrs 100 100  200  200 0 0 0>
            , <&key_physical_attrs 100 100  300  200 0 0 0>
            , <&key_physical_attrs 100 100  400  225 0 0 0>
            , <&key_physical_attrs 100 100  500  250 0 0 0>
            , <&key_physical_attrs 100 100  725  250 0 0 0>
            , <&key_physical_attrs 100 100  825  225 0 0 0>
            , <&key_physical_attrs 100 100  925  200 0 0 0>
            , <&key_physical_attrs 100 100 1025  200 0 0 0>
            , <&key_physical_attrs 100 100 1125  225 0 0 0>
            , <&key_physical_attrs 100 100 1225  225 0 0 0>
            , <&key_physical_attrs 100 100    0  325 0 0 0>
            , <&key_physical_attrs 100 100  100  325 0 0 0>
            , <&key_physical_attrs 100 100  200  300 0 0 0>
            , <&key_physical_attrs 100 100  300  300 0 0 0>
            , <&key_physical_attrs 100 100  400  325 0 0 0>
            , <&key_physical_attrs 100 100  500  350 0 0 0>
            , <&key_physical_attrs 100 100  725  350 0 0 0>
            , <&key_physical_attrs 100 100  825  325 0 0 0>
            , <&key_physical_attrs 100 100  925  300 0 0 0>
            , <&key_physical_attrs 100 100 1025  300 0 0 0>
            , <&key_physical_attrs 100 100 1125  325 0 0 0>
            , <&key_physical_attrs 100 100 1225  325 0 0 0>
            , <&key_physical_attrs 100 100  275  480 0 0 0>
            , <&key_physical_attrs 100 100  375  480 0 0 0>
            , <&key_physical_attrs 100 100  500  480 0 0 0>
            , <&key_physical_attrs 100 100  725  480 0 0 0>
            , <&key_physical_attrs 100 100  850  480 0 0 0>
            , <&key_physical_attrs 100 100  950  480 0 0 0>
            ;
    };
};
