/*                       KEY POSITIONS (54 keys)

  ╭─────────────────────────╮ ╭─────────────────────────╮
  │ LN5 LN4 LN3 LN2 LN1 LN0 │ │ RN0 RN1 RN2 RN3 RN4 RN5 │
  │ LT5 LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 RT5 │
  │ LM5 LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 RM5 │
  │ LB5 LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 RB5 │
  ╰───────────╮ LH2 LH1 LH0 │ │ RH0 RH1 RH2 ╭───────────╯
              ╰─────────────╯ ╰─────────────╯

  Base layer (Graphite):  LT4 LT3 LT2 LT1 = B L D W    RT1 RT2 RT3 = F O U
                          LB4 LB3 LB2 = Q X M    RB2 RB3     = . -    */

#define COMBO_TERM_FAST 50 // same as the Corne Vial combo term
#define COMBO_IDLE_FAST 150

/* Left hand */
ZMK_COMBO(esc_l, &kp ESC,         LT4 LT3,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(gui,   &sk LGUI,        LT3 LT2,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(quit,  &kp LG(Q),       LT4 LT3 LT2, DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(enter, &kp RET,         LT3 LT1,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(hyper, &sk LS(LC(LA(LGUI))), LT2 LT1, DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(cut,   &kp LG(X),       LB4 LB3,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(copy,  &kp LG(C),       LB3 LB2,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* Right hand */
ZMK_COMBO(meh_r, &sk LS(LC(LALT)), RT1 RT2,    DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(esc_r, &kp ESC,         RT1 RT3,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(quote, &gr_sqt,         RT2 RT3,     DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(meh,   &sk LS(LC(LALT)), RB2 RB3,   DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
